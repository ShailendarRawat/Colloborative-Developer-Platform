{
  "name": "developer_collab_platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/platform.test.mjs",
    "preview": "vite preview",
    "build:electron": "tsc -p tsconfig.electron.json && cp src/preload/preload.cjs dist-electron/preload/preload.cjs",
    "build:server": "tsc -p tsconfig.server.json",
    "server": "npm run build:server && node dist-server/server/index.js",
    "start:electron": "electron .",
    "dev:desktop": "npm run build:electron && concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:all": "npm run dev:desktop",
    "package:dir": "npm run build && npm run build:electron && electron-builder --dir",
    "package:mac": "npm run build && npm run build:electron && electron-builder --mac",
    "package:win": "npm run build && npm run build:electron && electron-builder --win",
    "package": "npm run build && npm run build:electron && electron-builder"
  },
  "build": {
    "appId": "com.collab.platform",
    "productName": "DeveloperCollabPlatform",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tldraw/tldraw": "^5.4.0",
    "firebase": "^12.19.0",
    "livekit-client": "^2.22.3",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "ws": "^8.21.0",
    "y-indexeddb": "^9.0.12",
    "y-monaco": "^0.1.6",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wait": "^0.4.2",
    "wait-on": "^9.1.0"
  }
}
